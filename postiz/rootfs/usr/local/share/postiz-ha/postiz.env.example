# -----------------------------------------------------------------------------
# postiz.env - optional extra Postiz environment variables.
#
# Location in Home Assistant: the "addon_configs" / "app_configs" share, folder
# "<repo-id>_postiz/postiz.env". Edit via Samba or the Advanced SSH & Web Terminal app, then
# restart the Postiz app.
#
# Rules (enforced by the app's start script):
#   * One KEY=VALUE per line. Lines starting with # are comments.
#   * KEY must be UPPER_CASE letters, digits and underscores.
#   * VALUE is used literally: no $VARIABLE expansion, no command execution.
#     Surrounding single or double quotes are removed.
#   * Infrastructure keys managed by the app (DATABASE_URL, REDIS_URL,
#     TEMPORAL_ADDRESS, JWT_SECRET, FRONTEND_URL, MAIN_URL,
#     NEXT_PUBLIC_BACKEND_URL, BACKEND_INTERNAL_URL, UPLOAD_DIRECTORY,
#     NOT_SECURED, STORAGE_PROVIDER, DISABLE_REGISTRATION, ...) are ignored
#     with a warning.
#   * If the same setting is ALSO filled in on the app's Configuration tab,
#     the Configuration tab wins.
#
# Variable names below come from the Postiz source/docs for the pinned
# Postiz version (see https://docs.postiz.com/configuration/reference).
# Never commit real secrets to git.
# -----------------------------------------------------------------------------

# --- Providers not on the Configuration tab ---------------------------------
# LinkedIn Page uses the LinkedIn keys. Instagram via Facebook Business uses the
# Facebook keys.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# SLACK_ID=
# SLACK_SECRET=
# DRIBBBLE_CLIENT_ID=
# DRIBBBLE_CLIENT_SECRET=
# TELEGRAM_TOKEN=
# TELEGRAM_BOT_NAME=
# BEEHIIVE_API_KEY=
# BEEHIIVE_PUBLICATION_ID=
# TIKTOK_BUSINESS_CLIENT_ID=
# TIKTOK_BUSINESS_CLIENT_SECRET=

# --- X extras ----------------------------------------------------------------
# DISABLE_X_ANALYTICS=true
# STRIP_LINKS_FROM_X_POSTS=true

# --- Generic OIDC login (e.g. Authentik) ---------------------------------------
# POSTIZ_GENERIC_OAUTH=true
# NEXT_PUBLIC_POSTIZ_OAUTH_DISPLAY_NAME=Authentik
# NEXT_PUBLIC_POSTIZ_OAUTH_LOGO_URL=
# POSTIZ_OAUTH_AUTH_URL=https://auth.example.com/application/o/authorize/
# POSTIZ_OAUTH_TOKEN_URL=https://auth.example.com/application/o/token/
# POSTIZ_OAUTH_USERINFO_URL=https://auth.example.com/application/o/userinfo/
# POSTIZ_OAUTH_CLIENT_ID=
# POSTIZ_OAUTH_CLIENT_SECRET=
# Note: with DISABLE_REGISTRATION=true, Postiz still allows NEW accounts via
# generic OIDC (verified in apps/backend/src/services/auth/auth.service.ts),
# so only enable OIDC against an identity provider whose users you trust.

# --- Short links ---------------------------------------------------------------
# DUB_TOKEN=
# DUB_API_ENDPOINT=https://api.dub.co
# DUB_SHORT_LINK_DOMAIN=dub.sh

# --- Misc -----------------------------------------------------------------------
# Mastodon and some other providers download media from Postiz's own public URL;
# SSRF protection blocks private (LAN) addresses. Only relax this if you know why.
# DISABLE_SSRF_PROTECTION=true
# Node.js heap cap per Postiz process, if you want to bound memory:
# NODE_OPTIONS=--max-old-space-size=1024
